{
	// Output
	"pulseaudio#output": {
    		"format": "{icon}",
		"format-bluetooth": "{icon} 󰂯",
		"format-icons": {
			"default": [ "󰕿", "󰖀", "󰕾" ],
			"default-muted": "󰝟",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐"
		},

		"min-length": 2,
		"max-length": 4,
		"align": 0.5,
		"justify": "center",

		"scroll-step": 0,

		"max-volume": 100,

		"tooltip": true,
		"tooltip-format": "<b>Device:</b> {desc}\n<b>Volume:</b> {volume}% {icon}"

	},

	// Input
	"pulseaudio#input": {
    		"format": "{format_source}",

		"format-source": "󰍬",
		"format-source-muted": "󰍭",

		"min-length": 2,
		"max-length": 2,
		"align": 0.5,
		"justify": "center",
		
		"scroll-step": 0,

		"tooltip": true,
		"tooltip-format": "<b>Device:</b> {source_desc}\n<b>Volume:</b> {source_volume}% {format_source}"
	}
}
